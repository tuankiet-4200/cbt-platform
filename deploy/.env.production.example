NODE_ENV=production
API_PORT=3000
API_HOST_PORT=3100
FRONTEND_URL=https://demoserver.io.vn

POSTGRES_USER=cbt_user
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_HEX
POSTGRES_DB=cbt_platform
DATABASE_URL=postgresql://cbt_user:REPLACE_WITH_SAME_POSTGRES_PASSWORD@postgres:5432/cbt_platform?schema=public

REDIS_PASSWORD=REPLACE_WITH_OPENSSL_HEX
REDIS_URL=redis://:REPLACE_WITH_SAME_REDIS_PASSWORD@redis:6379

JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_OPENSSL_RAND_HEX_64
JWT_REFRESH_EXPIRES_IN=7d

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_IMAGES_BUCKET=images
SUPABASE_CONTRIBUTIONS_BUCKET=contributions
